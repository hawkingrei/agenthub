module(
    name = "agenthub",
    version = "0.1.0",
)

bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "rules_cc", version = "0.0.17")
bazel_dep(name = "rules_rust", version = "0.67.0")

git_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:git.bzl", "git_repository")
git_repository(
    name = "codex_src",
    commit = "c34b30a3c128bb75fcec27ef838c93c99b92fc61",
    remote = "https://github.com/zed-industries/codex",
)

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
    versions = ["1.93.1"],
)
use_repo(rust, "rust_toolchains")

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.annotation(
    crate = "codex-linux-sandbox",
    deps = ["//third_party/codex_linux_sandbox:vendored_bwrap_ffi"],
    gen_build_script = "off",
    repositories = ["crate_index"],
    rustc_flags = ["--cfg=vendored_bwrap_available"],
)
crate.from_cargo(
    name = "crate_index",
    cargo_lockfile = "//:Cargo.lock",
    manifests = ["//:Cargo.toml"],
)
use_repo(crate, "crate_index")
