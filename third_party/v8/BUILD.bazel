package(default_visibility = ["//visibility:public"])

config_setting(
    name = "platform_aarch64_apple_darwin",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:osx",
    ],
)

config_setting(
    name = "platform_aarch64_unknown_linux_gnu",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
    ],
)

config_setting(
    name = "platform_x86_64_apple_darwin",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:osx",
    ],
)

config_setting(
    name = "platform_x86_64_unknown_linux_gnu",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)

alias(
    name = "v8_147_4_0_aarch64_apple_darwin_archive",
    actual = "@rusty_v8_147_4_0_aarch64_apple_darwin_archive//file",
)

alias(
    name = "v8_147_4_0_aarch64_unknown_linux_gnu_archive",
