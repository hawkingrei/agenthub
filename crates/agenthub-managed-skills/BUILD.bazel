load("@crate_index//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "agenthub_managed_skills",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "agenthub_managed_skills",
    compile_data = [
        "//:skills/team/team-agents-index.SKILL.md",
        "//:skills/team/team-coordinator-orchestrator.SKILL.md",
        "//:skills/team/team-worker-executor.SKILL.md",
        "//:skills/team/team-task-lifecycle.SKILL.md",
        "//:skills/team/team-deliberation-rules.SKILL.md",
        "//:skills/team/team-actor-mailbox.SKILL.md",
    ],
    edition = "2024",
    aliases = aliases(),
    deps = all_crate_deps(normal = True),
    proc_macro_deps = all_crate_deps(proc_macro = True),
)

rust_test(
    name = "agenthub_managed_skills_tests",
    crate = ":agenthub_managed_skills",
    compile_data = [
        "//:skills/team/team-agents-index.SKILL.md",
        "//:skills/team/team-coordinator-orchestrator.SKILL.md",
        "//:skills/team/team-worker-executor.SKILL.md",
        "//:skills/team/team-task-lifecycle.SKILL.md",
        "//:skills/team/team-deliberation-rules.SKILL.md",
        "//:skills/team/team-actor-mailbox.SKILL.md",
    ],
    edition = "2024",
    aliases = aliases(
        normal_dev = True,
        proc_macro_dev = True,
    ),
    deps = all_crate_deps(normal_dev = True),
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
)
