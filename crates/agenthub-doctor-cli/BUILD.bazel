load("@crate_index//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "agenthub_doctor_cli",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "agenthub_doctor_cli",
    edition = "2024",
    aliases = aliases(),
    deps = all_crate_deps(normal = True) + [
        "//crates/agenthub-diagnostics:agenthub_diagnostics",
        "//crates/agenthub-managed-skills:agenthub_managed_skills",
    ],
    proc_macro_deps = all_crate_deps(proc_macro = True),
)

rust_test(
    name = "agenthub_doctor_cli_tests",
    crate = ":agenthub_doctor_cli",
    edition = "2024",
    aliases = aliases(
        normal_dev = True,
        proc_macro_dev = True,
    ),
    deps = all_crate_deps(normal_dev = True) + [
        "//crates/agenthub-diagnostics:agenthub_diagnostics",
        "//crates/agenthub-managed-skills:agenthub_managed_skills",
    ],
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
)
