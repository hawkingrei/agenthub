load("@crate_index//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "agenthub_codex_acp_runtime",
    srcs = glob(["src/**/*.rs"]),
    compile_data = glob(["src/**/*.md"]) + [
        "NOTICE",
        "THIRD_PARTY_NOTICES.md",
    ],
    crate_name = "agenthub_codex_acp_runtime",
    crate_root = "src/lib.rs",
    edition = "2024",
    aliases = aliases(),
    deps = all_crate_deps(normal = True) + [
        "//crates/agenthub-managed-skills:agenthub_managed_skills",
    ],
    proc_macro_deps = all_crate_deps(proc_macro = True),
)

rust_binary(
    name = "agenthub_codex_acp_bin",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/main.rs",
    edition = "2024",
    aliases = aliases(),
    deps = all_crate_deps(normal = True) + [
        ":agenthub_codex_acp_runtime",
    ],
    proc_macro_deps = all_crate_deps(proc_macro = True),
)

rust_test(
    name = "agenthub_codex_acp_tests",
    crate = ":agenthub_codex_acp_runtime",
    compile_data = [
        "NOTICE",
        "THIRD_PARTY_NOTICES.md",
    ],
    edition = "2024",
    aliases = aliases(
        normal_dev = True,
        proc_macro_dev = True,
    ),
    deps = all_crate_deps(normal_dev = True),
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
)
