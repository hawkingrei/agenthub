load("@crate_index//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

exports_files(
    [
        "skills/team/AGENTS.md",
        "skills/team/team-agents-index.SKILL.md",
        "skills/team/team-leader-agents-index.SKILL.md",
        "skills/team/team-worker-agents-index.SKILL.md",
        "skills/team/team-coordinator-orchestrator.SKILL.md",
        "skills/team/team-worker-executor.SKILL.md",
        "skills/team/team-reporting-surfaces.SKILL.md",
        "skills/team/team-task-governance.SKILL.md",
        "skills/team/team-task-lifecycle.SKILL.md",
        "skills/team/team-deliberation-rules.SKILL.md",
        "skills/team/team-actor-mailbox.SKILL.md",
        "skills/team/TEAM_AGENTS.md",
    ],
    visibility = ["//visibility:public"],
)

rust_library(
    name = "agenthub_lib",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/main.rs"],
    ),
    crate_name = "agenthub",
    crate_root = "src/lib.rs",
    compile_data = [
        "Cargo.toml",
        "//agenthub-codex-acp:Cargo.toml",
        "//crates/agenthub-acp-adapter:Cargo.toml",
        "//crates/agenthub-daemon:Cargo.toml",
        "//crates/agenthub-object-store:Cargo.toml",
        ".github/workflows/release.yml",
        ".github/workflows/release-prebuild.yml",
        "build/deb/agenthub.service",
        "build/deb/package.sh",
        "docs/journal/2026-08-08-object-store-s3-release-enablement.md",
        "docs/todo.md",
        "web/index.html",
    ] + glob(
        ["web/dist/**"],
        allow_empty = True,
    ),
    edition = "2024",
    aliases = aliases(),
    deps = all_crate_deps(normal = True) + [
        "//crates/agenthub-acp:agenthub_acp",
        "//crates/agenthub-internal-p2p:agenthub_internal_p2p",
        "//crates/agenthub-text:agenthub_text",
        "//crates/agenthub-team-actor:agenthub_team_actor",
        "//crates/agenthub-team-domain:agenthub_team_domain",
        "//crates/agenthub-team-prompts:agenthub_team_prompts",
        "//crates/agenthub-agent-domain:agenthub_agent_domain",
        "//crates/agenthub-agent-event-codec:agenthub_agent_event_codec",
        "//crates/agenthub-auth-domain:agenthub_auth_domain",
        "//crates/agenthub-auth-passkeys:agenthub_auth_passkeys",
        "//crates/agenthub-auth-store:agenthub_auth_store",
        "//crates/agenthub-diagnostics:agenthub_diagnostics",
        "//crates/agenthub-doctor-cli:agenthub_doctor_cli",
        "//crates/agenthub-internal-tls:agenthub_internal_tls",
        "//crates/agenthub-linkers:agenthub_linkers",
        "//crates/agenthub-push:agenthub_push",
        "//crates/agenthub-logging:agenthub_logging",
        "//crates/agenthub-message-archive:agenthub_message_archive",
        "//crates/agenthub-message-store:agenthub_message_store",
        "//crates/agenthub-object-store:agenthub_object_store",
        "//crates/agenthub-pyroscope:agenthub_pyroscope",
        "//crates/agenthub-config:agenthub_config",
        "//crates/agenthub-db:agenthub_db",
        "//crates/agenthub-managed-skills:agenthub_managed_skills",
    ],
    proc_macro_deps = all_crate_deps(proc_macro = True),
)

rust_test(
    name = "agenthub_unit_tests",
    crate = ":agenthub_lib",
    edition = "2024",
    aliases = aliases(
        proc_macro_dev = True,
        normal_dev = True,
    ),
    deps = all_crate_deps(normal_dev = True),
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    timeout = "long",
)

rust_binary(
    name = "agenthub",
    srcs = ["cmd/agenthub/src/main.rs"],
    edition = "2024",
    aliases = aliases(),
    deps = all_crate_deps(normal = True) + [":agenthub_lib"],
    proc_macro_deps = all_crate_deps(proc_macro = True),
)

rust_test(
    name = "web_assets_test",
    srcs = ["tests/web_assets.rs"],
    data = ["web/src/styles.css"],
    crate_root = "tests/web_assets.rs",
    edition = "2024",
)
