load("@crate_index//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_binary(
    name = "agenthub",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/main.rs",
    edition = "2024",
    aliases = aliases(),
    deps = all_crate_deps(normal = True) + [
        "//crates/agenthub-acp:agenthub_acp",
        "//crates/agenthub-team-actor:agenthub_team_actor",
    ],
    proc_macro_deps = all_crate_deps(proc_macro = True),
)

rust_test(
    name = "agenthub_unit_tests",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/main.rs",
    edition = "2024",
    aliases = aliases(
        normal = True,
        normal_dev = True,
        proc_macro = True,
        proc_macro_dev = True,
    ),
    deps = all_crate_deps(
        normal = True,
        normal_dev = True,
    ) + [
        "//crates/agenthub-acp:agenthub_acp",
        "//crates/agenthub-team-actor:agenthub_team_actor",
    ],
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
        proc_macro_dev = True,
    ),
    timeout = "long",
)

rust_test(
    name = "web_assets_test",
    srcs = ["tests/web_assets.rs"],
    data = ["web/src/styles.css"],
    crate_root = "tests/web_assets.rs",
    edition = "2024",
)
