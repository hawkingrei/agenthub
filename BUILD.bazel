load("//:bazel/ci/defs.bzl", "workspace_shell_build", "workspace_shell_test")

filegroup(
    name = "workspace_sources",
    srcs = glob(
        ["**"],
        exclude = [
            "bazel-*/**",
            "target/**",
            "web/node_modules/**",
            "web/dist/**",
            "web/coverage/**",
        ],
    ),
)

workspace_shell_build(
    name = "rust_build",
    tool = "//:bazel/ci/rust_build.sh",
    data = [":workspace_sources"],
)

workspace_shell_build(
    name = "web_build",
    tool = "//:bazel/ci/web_build.sh",
    data = [":workspace_sources"],
)

filegroup(
    name = "ci_build",
    srcs = [
        ":rust_build",
        ":web_build",
    ],
)

workspace_shell_test(
    name = "rust_test",
    tool = "//:bazel/ci/rust_test.sh",
    data = [":workspace_sources"],
)

workspace_shell_test(
    name = "web_test",
    tool = "//:bazel/ci/web_test.sh",
    data = [":workspace_sources"],
)

test_suite(
    name = "ci_tests",
    tests = [
        ":rust_test",
        ":web_test",
    ],
)
