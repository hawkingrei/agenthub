{
  "name": "agenthub-web",
  "private": true,
  "version": "0.0.10",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint . --ext .ts,.tsx,.js",
    "test": "vitest run",
    "test:coverage:core": "NODE_OPTIONS='--max-old-space-size=6144' vitest run --pool=forks --maxWorkers=1 --exclude src/pages/team_page.smoke.test.tsx --coverage.enabled --coverage.provider=v8 --coverage.reporter=lcov",
    "test:smoke": "vitest run src/pages/team_page.smoke.test.tsx",
    "test:coverage": "npm run test:coverage:core && npm run test:smoke",
    "e2e": "playwright test",
    "e2e:coverage": "PLAYWRIGHT_E2E_COVERAGE=1 playwright test",
    "e2e:coverage:mobile": "PLAYWRIGHT_E2E_COVERAGE=1 PLAYWRIGHT_MOBILE_ONLY=1 playwright test",
    "e2e:llm-local": "PLAYWRIGHT_LOCAL_LLM_E2E=1 playwright test -g \"\\[local-llm\\]\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.8",
    "@mantine/core": "9.4.1",
    "@mantine/hooks": "9.4.1",
    "bootstrap-icons": "^1.11.3",
    "highlight.js": "^11.11.1",
    "markdown-it": "^14.2.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.7",
    "uuidv7": "^1.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/markdown-it": "^14.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.0",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.5.2",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.16",
    "tailwindcss": "^4.2.4",
    "typescript": "6.0.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.9"
  }
}
