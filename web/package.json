{
  "name": "agenthub-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint . --ext .ts,.tsx,.js",
    "test": "vitest run",
    "test:coverage:core": "NODE_OPTIONS=--max-old-space-size=6144 vitest run --pool=forks --maxWorkers=1 --exclude src/pages/team_page.smoke.test.tsx --coverage.enabled --coverage.provider=v8 --coverage.reporter=lcov",
    "test:smoke": "vitest run src/pages/team_page.smoke.test.tsx",
    "test:coverage": "npm run test:coverage:core && npm run test:smoke",
    "e2e": "playwright test",
    "e2e:coverage": "PLAYWRIGHT_E2E_COVERAGE=1 playwright test",
    "e2e:llm-local": "PLAYWRIGHT_LOCAL_LLM_E2E=1 playwright test -g \"\\[local-llm\\]\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "@mantine/core": "8.3.18",
    "@mantine/hooks": "8.3.18",
    "bootstrap-icons": "^1.11.3",
    "highlight.js": "^11.11.1",
    "markdown-it": "^14.1.1",
    "qrcode": "^1.5.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "uuidv7": "^1.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.2.0",
    "@types/markdown-it": "^14.1.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.0",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.2",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.1",
    "autoprefixer": "^10.4.27",
    "eslint": "^10.1.0",
    "eslint-plugin-react-hooks": "7.1.0-canary-52684925-20251110",
    "globals": "^17.4.0",
    "jsdom": "^29.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.2.2",
    "typescript": "6.0.2",
    "vite": "^8.0.2",
    "vitest": "^4.1.2"
  }
}
