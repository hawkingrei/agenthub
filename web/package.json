{
  "name": "agenthub-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint . --ext .ts,.tsx,.js",
    "test": "vitest run",
    "test:coverage": "NODE_OPTIONS=--max-old-space-size=6144 vitest run --pool=forks --maxWorkers=1 --coverage.enabled --coverage.provider=v8 --coverage.reporter=lcov",
    "e2e": "playwright test",
    "e2e:coverage": "PLAYWRIGHT_E2E_COVERAGE=1 playwright test",
    "e2e:llm-local": "PLAYWRIGHT_LOCAL_LLM_E2E=1 playwright test -g \"\\[local-llm\\]\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "@mantine/core": "7.17.8",
    "@mantine/hooks": "7.17.8",
    "bootstrap-icons": "^1.11.3",
    "highlight.js": "^11.11.1",
    "markdown-it": "^14.1.1",
    "qrcode": "^1.5.3",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "uuidv7": "^1.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.2.0",
    "@types/markdown-it": "^14.1.2",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.55.0",
    "@typescript-eslint/parser": "^8.55.0",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitest/coverage-v8": "^4.0.18",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.0.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^13.24.0",
    "jsdom": "^24.1.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.2.0",
    "typescript": "5.5.4",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
